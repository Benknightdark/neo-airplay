<UserControl x:Class="NeoAirPlay.Views.SettingsView"
             AutomationProperties.AutomationId="SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="接收器偏好" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,4" />
            <TextBlock Text="設定將套用至下一次啟動；運作中的接收器可重新啟動以套用變更。"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,0,0,18" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="AirPlay 顯示名稱" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding ReceiverName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80" Width="360" HorizontalAlignment="Left" />
                    <TextBlock Text="Apple 裝置的 AirPlay 選單會顯示這個名稱。"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,21,0,18" />

                    <TextBlock Text="影片輸出" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding RendererOptions}" SelectedItem="{Binding SelectedRenderer}"
                              Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="Auto 會由 GStreamer 選擇可用的輸出方式。"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,21,0,18" />
                    <CheckBox Content="全螢幕播放鏡像畫面" IsChecked="{Binding Fullscreen}" />
                    <TextBlock Text="播放視窗會以全螢幕方式開啟。"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="22,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Windows 啟動" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="登入 Windows 後自動啟動 Neo AirPlay" IsChecked="{Binding StartOnLogin}" Margin="0,14,0,0" />
                    <TextBlock Text="啟動時會縮至系統匣並自動啟動接收器。"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="22,6,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#FFF5E8" BorderBrush="#F1D2A9" BorderThickness="1" CornerRadius="9"
                    Padding="12,10" Margin="0,0,0,15"
                    Visibility="{Binding ShowApplyWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="接收器仍在使用舊設定。儲存後按「重新啟動並套用」才會生效。"
                           Foreground="#714500" FontSize="11" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,18">
                <Button Content="儲存設定" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="重新啟動並套用" Command="{Binding ApplySettingsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                        Visibility="{Binding ShowApplyWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
