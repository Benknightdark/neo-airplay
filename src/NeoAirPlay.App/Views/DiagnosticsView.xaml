<UserControl x:Class="NeoAirPlay.Views.DiagnosticsView"
             AutomationProperties.AutomationId="DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,15">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="執行記錄" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="最近的接收器狀態與錯誤訊息。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="開啟記錄資料夾" Command="{Binding OpenLogsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="White" BorderThickness="0" RowHeight="40"
                      ColumnHeaderHeight="38" AlternatingRowBackground="#FAFCFE">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時間" Binding="{Binding DisplayTime}" Width="90" />
                    <DataGridTextColumn Header="類型" Binding="{Binding DisplayLevel}" Width="82" />
                    <DataGridTextColumn Header="訊息" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
