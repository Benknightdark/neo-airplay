<UserControl x:Class="NeoAirPlay.Views.DashboardView"
             AutomationProperties.AutomationId="DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource CardBorderStyle}" Padding="28" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding StatusAccent}" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PageTitleStyle}"
                                   FontSize="25" Margin="0,15,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusDescription}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" LineHeight="21" TextWrapping="Wrap" MaxWidth="590" />
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="啟動 AirPlay 接收器" Command="{Binding StartCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="{Binding IsReceiverStopped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="停止接收" Command="{Binding StopCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="{Binding IsReceiverRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="複製接收器名稱" Command="{Binding CopyReceiverNameCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0F6FF" CornerRadius="15" Padding="22"
                            VerticalAlignment="Center" MinHeight="185">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="20" Background="#DFEBFF"
                                    HorizontalAlignment="Center" Margin="0,0,0,13">
                                <TextBlock Text="⌁" FontSize="37" Foreground="#2878E5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0" />
                            </Border>
                            <TextBlock Text="AirPlay 接收就緒" Foreground="#245BA8" FontWeight="SemiBold"
                                       FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="畫面與音訊接收" Foreground="#71829A" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="如何連線" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="在 Apple 裝置上選擇這台電腦，開始鏡像或播放音訊。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,19" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" CornerRadius="8" Background="#EEF4FC">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#2878E5" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="啟動接收器" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="12" />
                                <TextBlock Text="按上方按鈕，讓裝置在網路上找到本機。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" CornerRadius="8" Background="#EEF4FC">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#2878E5" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="選擇 Neo AirPlay" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="12" />
                                <TextBlock Text="從控制中心或音訊播放選單選取接收器名稱。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="接收器資訊" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="目前顯示名稱" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,17,0,5" />
                        <DockPanel>
                            <TextBlock Text="{Binding ReceiverName}" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Button Content="複製" Command="{Binding CopyReceiverNameCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,15,0,13" />
                        <TextBlock Text="播放視窗" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock Text="使用獨立視窗顯示鏡像畫面，音訊同步輸出。"
                                   Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#EEF5FF" BorderBrush="#D8E7FB" BorderThickness="1" CornerRadius="10" Padding="13,11">
                <DockPanel>
                    <TextBlock Text="ⓘ" Foreground="#2878E5" FontSize="15" Margin="0,0,10,0" />
                    <TextBlock Text="第一次使用前，請確認本專案的 Bonjour Service 已安裝且正在執行。"
                               Foreground="#3E587B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
