<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
    <AssemblyName>NeoAirPlay</AssemblyName>
    <RootNamespace>NeoAirPlay</RootNamespace>
    <Title>Neo AirPlay</Title>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeoAirPlay.App.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoAirPlay.Framework\NeoAirPlay.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\engine\**\*"
             Link="engine\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Update="..\..\engine\bonjour\**\*"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
    <Content Include="..\..\scripts\Stage-BonjourRuntime.ps1"
             Link="scripts\Stage-BonjourRuntime.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\BonjourRuntimeHelpers.psm1"
             Link="scripts\BonjourRuntimeHelpers.psm1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\BonjourServiceSettings.json"
             Link="scripts\BonjourServiceSettings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Install-BonjourService.ps1"
             Link="scripts\Install-BonjourService.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\Restore-BonjourService.ps1"
             Link="scripts\Restore-BonjourService.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <None Update="engine-package.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
