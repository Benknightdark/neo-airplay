<Window x:Class="NeoAirPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NeoAirPlay.Views"
        Title="Neo AirPlay"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="20,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#2878E5" Margin="0,0,11,0">
                        <TextBlock Text="N" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Neo AirPlay" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="WINDOWS RECEIVER" Foreground="#93A5BD" FontSize="9" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="接收器" Foreground="#8193AC" FontSize="10" FontWeight="Bold"
                               Margin="10,0,0,10" />
                    <Button AutomationProperties.AutomationId="NavigateHome" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource HomeNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="17" Width="28"/><TextBlock Text="總覽" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button AutomationProperties.AutomationId="NavigateSettings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource SettingsNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="15" Width="28"/><TextBlock Text="設定" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button AutomationProperties.AutomationId="NavigateDiagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Style="{StaticResource DiagnosticsNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="15" Width="28"/><TextBlock Text="診斷記錄" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="#1E2D43" CornerRadius="12" Padding="13">
                    <StackPanel>
                        <TextBlock Text="接收狀態" Foreground="#A8B5C8" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusAccent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StateLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,26,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock AutomationProperties.AutomationId="CurrentPageHeading" Text="{Binding CurrentPageLabel}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="將 Apple 裝置的畫面與音訊接收到這台電腦。"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="最小化至系統匣" Command="{Binding MinimizeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1" Background="#FFF5E8" BorderBrush="#F1D2A9" BorderThickness="1"
                    CornerRadius="9" Padding="12,9" Margin="0,0,0,16"
                    Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="!" FontWeight="Bold" Foreground="#A95C00" FontSize="15" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AlertMessage}" Foreground="#714500" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissAlertCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#714500" FontSize="18"
                            Padding="7,0" Cursor="Hand" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <views:DashboardView Visibility="{Binding IsHomePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:DiagnosticsView Visibility="{Binding IsDiagnosticsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
