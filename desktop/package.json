{
  "name": "neo-airplay-desktop",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "node": "^24.22.2"
  },
  "scripts": {
    "setup:runtime": "bun run scripts/prepare-runtime.mjs",
    "release": "bun run tauri build --no-bundle",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "bun run scripts/run-tauri.mjs",
    "test:unit": "node scripts/run-desktop-test.mjs test:frontend",
    "test:setup": "node --test --test-reporter=dot scripts/test-setup.mjs",
    "test:version": "node --test --test-reporter=dot scripts/project-version.test.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "node scripts/run-desktop-test.mjs test:backend",
    "rust:clippy": "cargo clippy -q --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "verify": "bun run --silent typecheck && bun run --silent test:unit && bun run --silent test:setup && bun run --silent test:version && bun run --silent rust:fmt && bun run --silent rust:test && bun run --silent rust:clippy && bun run --silent build",
    "e2e:build": "node scripts/run-desktop-test.mjs e2e:build",
    "test:e2e": "node scripts/run-desktop-test.mjs test:e2e",
    "test:e2e:ci": "node scripts/run-desktop-test.mjs test:e2e:ci",
    "bundle": "bun run scripts/build-app.ts",
    "smoke:bundle": "bun run scripts/smoke-bundle.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@wdio/tauri-plugin": "^1.5.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
