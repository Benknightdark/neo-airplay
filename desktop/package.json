{
  "name": "neo-airplay-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "setup:runtime": "bun run scripts/prepare-runtime.mjs",
    "release": "bun run tauri build --no-bundle",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "bun run scripts/run-tauri.mjs",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run --reporter=dot",
    "test:setup": "node --test --test-reporter=dot scripts/test-setup.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-features -q",
    "rust:clippy": "cargo clippy -q --manifest-path src-tauri/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "verify": "bun run --silent typecheck && bun run --silent test:unit && bun run --silent test:setup && bun run --silent rust:fmt && bun run --silent rust:test && bun run --silent rust:clippy && bun run --silent build",
    "e2e:build": "bun run scripts/build-e2e.ts",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:ci": "bun run --silent e2e:build && bun run --silent test:e2e",
    "bundle": "bun run scripts/build-app.ts",
    "smoke:bundle": "bun run scripts/smoke-bundle.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "9.31.3",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.3",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.5",
    "webdriverio": "9.31.9"
  }
}
