{
  "name": "neo-airplay-desktop-test",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit --project frontend/tsconfig.json",
    "test:frontend": "bun run --silent typecheck && vitest run --config frontend/vitest.config.ts --reporter=dot",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml --locked -q",
    "test:unit": "bun run --silent test:frontend && bun run --silent test:backend",
    "verify": "bun run --silent test:unit",
    "e2e:build": "bun run scripts/build-e2e.ts",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "test:e2e:ci": "bun run --silent e2e:build && bun run --silent test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "9.31.3",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.3",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.5",
    "webdriverio": "9.31.9"
  }
}
