{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.neoairplay.desktop.e2e",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "僅供桌面端對端測試使用的操作權限",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
